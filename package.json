{
  "name": "math-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:lib": "tsc --noEmit && MG_LIB=1 MG_VERSION=$(git rev-parse --short HEAD) vite build && tsc -p tsconfig.lib.json",
    "presets": "npm run -s build:lib > /dev/null && node scripts/presets.mjs"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "happy-dom": "^18.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4"
  }
}
